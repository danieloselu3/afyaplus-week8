# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: docker --env-file does not strip inline comments.
OPENAI_API_KEY=sk-your-key-here
JWT_SECRET=pick-a-long-random-string-at-least-32-characters
# production = refuse to start without JWT_SECRET
APP_ENV=development
# openai | stub (free deterministic model, used by the test suite)
TRIAGE_BACKEND=openai
# --- Week 7 (all optional) ---
# Any OpenAI-compatible endpoint; empty = api.openai.com
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Response cache: Redis when reachable, else an in-process dict
CACHE_ENABLED=true
CACHE_TTL_S=600
REDIS_URL=
# Per-coordinator /triage calls a minute
TRIAGE_RATE_LIMIT_PER_MIN=5
